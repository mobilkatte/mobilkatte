# Salin file ini menjadi .env.local lalu isi nilainya.
# Ambil kredensial dari dashboard Supabase > Project Settings > API.

# URL proyek Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Service role key Supabase (Project Settings > API > service_role) — HANYA untuk server.
SUPABASE_SERVICE_ROLE_KEY=

# Secret untuk menandatangani token login admin (ganti dengan string acak)
AUTH_SECRET=